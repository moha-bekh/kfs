.PHONY: all run build clean fclean re check-multiboot gdb-server monitor

BUILD_DIR = build
BOOT_DIR = $(BUILD_DIR)/boot
ISO_DIR = $(BUILD_DIR)/iso
GRUB_DIR = $(ISO_DIR)/boot/grub

ELF = $(BUILD_DIR)/kfs.elf
ISO = kfs.iso

# Debian/Ubuntu: grub-mkrescue / grub-file — Fedora: grub2-mkrescue / grub2-file
# Override possible: make GRUB_MKRESCUE=/path/to/tool
GRUB_MKRESCUE ?= $(shell command -v grub-mkrescue 2>/dev/null || command -v grub2-mkrescue 2>/dev/null)
GRUB_FILE ?= $(shell command -v grub-file 2>/dev/null || command -v grub2-file 2>/dev/null)

GRUB_CONFIG = grub/grub.cfg
GRUB_MKRESCUE_FLAGS = \
	--directory=/usr/lib/grub/i386-pc \
	--locales= --themes= --fonts=

# QEMU display backend: gtk (window), curses (in the terminal), vnc=:0, none...
# Override possible: make run QEMU_DISPLAY=curses or QEMU_DISPLAY=gtk
QEMU_DISPLAY ?= curses
# QEMU monitor reachable from another terminal: make monitor
QEMU_MONITOR_PORT ?= 4444
QEMU_FLAGS = \
	-display $(QEMU_DISPLAY) \
	-cdrom $(ISO) \
	-monitor telnet:127.0.0.1:$(QEMU_MONITOR_PORT),server,nowait

LINKER_SCRIPT = link/linker.ld

# KFS-1: boot, screen, helpers (+ bonus: printk, keyboard)
C_SRC = \
	src/kernel/main.c \
	src/console/console.c \
	src/drivers/vga.c \
	src/lib/string.c \
	src/lib/printk.c \
	src/drivers/keyboard.c

# KFS-2: GDT, stack (+ bonus: shell)
C_SRC += \
	src/cpu/gdt.c \
	src/debug/stack.c \
	src/shell/shell.c

# KFS-3: memory (+ bonus: memdump)
C_SRC += \
	src/boot/multiboot.c \
	src/mm/pmm.c \
	src/mm/paging.c \
	src/mm/kmalloc.c \
	src/mm/vmalloc.c \
	src/kernel/panic.c \
	src/debug/memdump.c

# KFS-4: interrupts (+ bonus: syscalls)
C_SRC += \
	src/cpu/idt.c \
	src/cpu/exceptions.c \
	src/drivers/pic.c \
	src/drivers/pit.c \
	src/kernel/signal.c \
	src/kernel/syscall.c

# KFS-5: processes
C_SRC += \
	src/proc/process.c \
	src/proc/proc_signal.c \
	src/proc/socket.c \
	src/proc/sched.c \
	src/proc/exec.c

ASM_SRC = \
	src/boot/boot.s \
	src/cpu/gdt_flush.s \
	src/cpu/isr.s \
	src/proc/switch.s

CFLAGS = \
	-m32 \
	-Wall -Wextra -Werror -Wmissing-prototypes \
	-fno-builtin \
	-fno-stack-protector \
	-ffreestanding \
	-fno-pie

OBJ = \
	$(patsubst src/%.c, $(BUILD_DIR)/%.o, $(C_SRC)) \
	$(patsubst src/%.s, $(BUILD_DIR)/%.o, $(ASM_SRC))

# One .d per .o (build/mm/paging.o -> build/mm/paging.d), generated by -MMD/-MD
DEP = $(OBJ:.o=.d)

all: $(ISO) run

run: $(ISO)
	qemu-system-i386 $(QEMU_FLAGS)

monitor:
	telnet 127.0.0.1 $(QEMU_MONITOR_PORT)

build: $(ELF)

$(ISO): $(ELF) $(GRUB_CONFIG)
	mkdir -p $(GRUB_DIR)
	cp $(GRUB_CONFIG) $(GRUB_DIR)
	cp $(ELF) $(ISO_DIR)/boot/kfs.elf
	@test -n "$(GRUB_MKRESCUE)" || { echo "error: grub-mkrescue/grub2-mkrescue not found (install grub-pc-bin or grub2-tools + grub2-pc-modules)"; exit 1; }
	$(GRUB_MKRESCUE) $(GRUB_MKRESCUE_FLAGS) $(ISO_DIR) -o $(ISO)

$(ELF): $(OBJ) $(LINKER_SCRIPT)
	ld -m elf_i386 $(OBJ) -T link/linker.ld -o $@

$(BUILD_DIR)/%.o: src/%.s
	mkdir -p $(dir $@)
	nasm -f elf32 -MD $(@:.o=.d) -MP $< -o $@

$(BUILD_DIR)/%.o: src/%.c
	mkdir -p $(dir $@)
	cc $(CFLAGS) -I include -MMD -MP -c $< -o $@

check-multiboot:
	@test -n "$(GRUB_FILE)" || { echo "error: grub-file/grub2-file not found"; exit 1; }
	$(GRUB_FILE) --is-x86-multiboot2 $(ELF)

clean:
	rm -rf $(BUILD_DIR)

fclean: clean
	rm -rf $(ISO)

re: fclean all

gdb-server: $(ISO)
	qemu-system-i386 $(QEMU_FLAGS) -S -s
	# gdb build/kfs.elf
	# target remote localhost:1234
	# break _start
	# continue
	# info registers esp
	# disassemble kmain

# Header dependencies. Kept at the end so that rules read from .d files
# never become the default goal. "-" ignores missing .d (first build).
-include $(DEP)
